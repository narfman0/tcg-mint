# Scryfall bulk data: ~200 MB, rebuilt daily upstream; `mint cards` fetches it
oracle-cards.jsonl*
oracle-cards.stamp.json
default-cards.jsonl*
all-cards.jsonl*

# caches: art crops, scans and mana-symbol SVGs pulled from Scryfall
art/
symbols/

# rendered cards -- WotC art, never in git; release them via MPC Autofill
out/
*.png
!docs/*.png
!tests/golden/*.png

# fonts are not ours to redistribute; fonts/README.md says where they live
fonts/*
!fonts/README.md

__pycache__/
*.egg-info/
build/
dist/
.venv/

# your sets, style templates and settings: the workspace's, never the repo's (docs/examples/ shows the shapes)
sets/
styles/
mint.toml

# subagent worktrees
.claude/worktrees/

# workbench thumbnails and other caches
.cache/

# compose's environment: the ComfyUI token and the API key live there
.env

# the workbench icons, the one set of PNGs that is source
!mint/web/static/*.png
